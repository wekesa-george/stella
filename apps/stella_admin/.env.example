# Logto OAuth2 Configuration
# Get these values from your Logto admin console at https://auth.stella.praetocloud.com

# Your Logto App ID
LOGTO_APP_ID=

# Your Logto App Secret (REQUIRED - get from Logto console)
LOGTO_APP_SECRET=

# Logto endpoint
LOGTO_ENDPOINT=

# OAuth2 redirect URI (must match what's configured in Logto)
LOGTO_REDIRECT_URI=
# Server port
PORT=4000
