# ========================================
# Stella Admin Environment Configuration
# ========================================
# Copy this file to .env and fill in the values

# Server Configuration
# --------------------
PORT=4000
# Set to true to start the Phoenix server automatically
PHX_SERVER=true

# Database Configuration
# ----------------------
# PostgreSQL connection details for stella_platform_new
DB_HOST=170.168.103.207
DB_PORT=3212
DB_NAME=stella_platform_new
DB_USER=postgres
DB_PASSWORD=your_database_password_here
POOL_SIZE=10

# Logto OAuth2 Configuration (User Authentication)
# -------------------------------------------------
# Get these values from your Logto admin console at https://auth.stella.praetocloud.com
LOGTO_APP_ID=your_app_id_here
LOGTO_APP_SECRET=your_app_secret_here
LOGTO_ENDPOINT=https://auth.stella.praetocloud.com
LOGTO_REDIRECT_URI=http://localhost:4000/auth/callback

# Logto M2M Configuration (Management API)
# ----------------------------------------
# Machine-to-Machine credentials for accessing Logto Management API
LOGTO_M2M_APP_ID=your_m2m_app_id_here
LOGTO_M2M_APP_SECRET=your_m2m_app_secret_here

# Logto Webhook Configuration (Optional)
# ---------------------------------------
# Signing key for validating webhook payloads from Logto
# LOGTO_WEBHOOK_SIGNING_KEY=your_webhook_signing_key_here

# Production Configuration (Not needed for dev)
# ----------------------------------------------
# SECRET_KEY_BASE=run_mix_phx_gen_secret_to_generate
# PHX_HOST=your.production.domain.com
# DNS_CLUSTER_QUERY=your_dns_query
